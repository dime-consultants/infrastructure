upstream {{ app.name | regex_replace('[^A-Za-z0-9_]', '_') }}_{{ env.key | regex_replace('[^A-Za-z0-9_]', '_') }} {
    {% if load_balancing.method | default('round_robin') == 'least_conn' %}
    least_conn;
    {% elif load_balancing.method | default('round_robin') == 'ip_hash' %}
    ip_hash;
    {% endif %}
    {% for backend in backend_servers %}
    server {{ backend.host | default('127.0.0.1') }}:{{ backend.port | default(backend_port) }}{% if backend.weight is defined %} weight={{ backend.weight }}{% endif %} max_fails={{ backend.max_fails | default(load_balancing.max_fails | default(3)) }} fail_timeout={{ backend.fail_timeout | default(load_balancing.fail_timeout | default('30s')) }};
    {% endfor %}
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    {% if ssl_enabled %}
    location / {
        return 301 https://$host$request_uri;
    }
    {% else %}
    location / {
        proxy_pass http://{{ app.name | regex_replace('[^A-Za-z0-9_]', '_') }}_{{ env.key | regex_replace('[^A-Za-z0-9_]', '_') }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    {% endif %}
}

{% if ssl_enabled %}
server {
    listen 443 ssl http2;
    server_name {{ domain }};

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;

    client_max_body_size 50M;

    location / {
        proxy_pass http://{{ app.name | regex_replace('[^A-Za-z0-9_]', '_') }}_{{ env.key | regex_replace('[^A-Za-z0-9_]', '_') }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
{% endif %}
