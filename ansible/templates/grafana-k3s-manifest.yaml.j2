{% set grafana = k3s_grafana | default({}) %}
{% set namespace = grafana.namespace | default('grafana') %}
{% set domain = grafana.domain %}
{% set tls_secret = grafana.tls_secret | default((domain ~ '-tls') | regex_replace('[^A-Za-z0-9-]', '-') | lower) %}
{% set loki = grafana.loki | default({}) %}
{% set loki_enabled = loki.enabled | default(true) | bool %}
{% set promtail = grafana.promtail | default({}) %}
{% set promtail_enabled = promtail.enabled | default(loki_enabled) | bool %}
{% set promtail_namespaces = promtail.namespaces | default(kubernetes_namespaces | default(['prod', 'stage'])) %}
{% set cert_manager_config = k3s.cert_manager | default({}) %}
{% set cert_manager_issuer = cert_manager_config.cluster_issuer | default({}) %}
{% set cert_manager_enabled = cert_manager_config.enabled | default(false) | bool and cert_manager_issuer.enabled | default(true) | bool %}
apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: {{ namespace }}
type: Opaque
stringData:
  admin-user: {{ grafana_admin_user | to_json }}
  admin-password: {{ grafana_admin_password | to_json }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasources
  namespace: {{ namespace }}
data:
  datasources.yaml: |
    apiVersion: 1
    datasources:
{% if loki_enabled %}
      - name: Loki
        type: loki
        access: proxy
        url: http://loki.{{ namespace }}.svc.cluster.local:3100
        isDefault: true
        editable: false
{% endif %}
{% if loki_enabled %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: loki-config
  namespace: {{ namespace }}
data:
  config.yml: |
    auth_enabled: false

    server:
      http_listen_port: 3100
      grpc_listen_port: 9096

    common:
      path_prefix: /loki
      replication_factor: 1
      ring:
        kvstore:
          store: inmemory
      storage:
        filesystem:
          chunks_directory: /loki/chunks
          rules_directory: /loki/rules

    schema_config:
      configs:
        - from: 2024-04-01
          store: tsdb
          object_store: filesystem
          schema: v13
          index:
            prefix: index_
            period: 24h

    limits_config:
      retention_period: {{ loki.retention_period | default('24h') }}

    compactor:
      working_directory: /loki/compactor
      retention_enabled: true
      delete_request_store: filesystem
      retention_delete_delay: {{ loki.retention_delete_delay | default('2h') }}
      retention_delete_worker_count: {{ loki.retention_delete_worker_count | default(10) }}
{% endif %}
{% if promtail_enabled %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: promtail-config
  namespace: {{ namespace }}
data:
  config.yml: |
    server:
      http_listen_port: 9080
      grpc_listen_port: 0

    positions:
      filename: /run/promtail/positions.yaml

    clients:
      - url: http://loki.{{ namespace }}.svc.cluster.local:3100/loki/api/v1/push

    scrape_configs:
      - job_name: kubernetes-pods
        static_configs:
{% for log_namespace in promtail_namespaces %}
          - targets:
              - localhost
            labels:
              job: kubernetes-pods
              __path__: /var/log/pods/{{ log_namespace }}_*/*/*.log
{% endfor %}
        pipeline_stages:
          - cri: {}
          - regex:
              source: filename
              expression: /var/log/pods/(?P<namespace>[^_]+)_(?P<pod>[^_]+)_(?P<pod_uid>[^/]+)/(?P<container>[^/]+)/[0-9]+\.log
          - regex:
              source: pod
              expression: (?P<app>.*)-(?P<environment>prod|stage)-dime-app-[^-]+-[^-]+
          - labels:
              namespace:
              pod:
              container:
              app:
              environment:
{% endif %}
---
kind: PersistentVolumeClaim
apiVersion: v1
metadata:
  name: grafana
  namespace: {{ namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ grafana.storage_size | default('10Gi') }}
{% if grafana.storage_class is defined %}
  storageClassName: {{ grafana.storage_class }}
{% endif %}
{% if loki_enabled %}
---
kind: PersistentVolumeClaim
apiVersion: v1
metadata:
  name: loki
  namespace: {{ namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ loki.storage_size | default('10Gi') }}
{% if loki.storage_class is defined %}
  storageClassName: {{ loki.storage_class }}
{% endif %}
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: grafana
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: grafana
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: grafana
  template:
    metadata:
      labels:
        app.kubernetes.io/name: grafana
    spec:
      securityContext:
        fsGroup: 472
      containers:
        - name: grafana
          image: {{ grafana.image | default('grafana/grafana-oss:11.1.4') }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
          env:
            - name: GF_SECURITY_ADMIN_USER
              valueFrom:
                secretKeyRef:
                  name: grafana-admin
                  key: admin-user
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: grafana-admin
                  key: admin-password
            - name: GF_SERVER_DOMAIN
              value: {{ domain | to_json }}
            - name: GF_SERVER_ROOT_URL
              value: {{ ('https://' ~ domain ~ '/') | to_json }}
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 40
            periodSeconds: 20
          volumeMounts:
            - name: data
              mountPath: /var/lib/grafana
            - name: datasources
              mountPath: /etc/grafana/provisioning/datasources
              readOnly: true
          resources:
{{ grafana.resources | default({'requests': {'cpu': '50m', 'memory': '128Mi'}, 'limits': {'cpu': '500m', 'memory': '512Mi'}}) | to_nice_yaml(indent=2) | indent(12, true) }}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: grafana
        - name: datasources
          configMap:
            name: grafana-datasources
---
apiVersion: v1
kind: Service
metadata:
  name: grafana
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: grafana
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: grafana
  ports:
    - name: http
      port: 80
      targetPort: http
      protocol: TCP
{% if loki_enabled %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loki
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: loki
    app.kubernetes.io/part-of: observability
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: loki
  template:
    metadata:
      labels:
        app.kubernetes.io/name: loki
        app.kubernetes.io/part-of: observability
    spec:
      securityContext:
        fsGroup: 10001
      containers:
        - name: loki
          image: {{ loki.image | default('grafana/loki:3.1.1') }}
          imagePullPolicy: IfNotPresent
          args:
            - -config.file=/etc/loki/config.yml
          ports:
            - name: http
              containerPort: 3100
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /ready
              port: http
            initialDelaySeconds: 20
            periodSeconds: 10
          volumeMounts:
            - name: config
              mountPath: /etc/loki
              readOnly: true
            - name: data
              mountPath: /loki
          resources:
{{ loki.resources | default({'requests': {'cpu': '50m', 'memory': '128Mi'}, 'limits': {'cpu': '500m', 'memory': '512Mi'}}) | to_nice_yaml(indent=2) | indent(12, true) }}
      volumes:
        - name: config
          configMap:
            name: loki-config
        - name: data
          persistentVolumeClaim:
            claimName: loki
---
apiVersion: v1
kind: Service
metadata:
  name: loki
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: loki
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: loki
  ports:
    - name: http
      port: 3100
      targetPort: http
      protocol: TCP
{% endif %}
{% if promtail_enabled %}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: promtail
  namespace: {{ namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: promtail
rules:
  - apiGroups:
      - ""
    resources:
      - nodes
      - nodes/proxy
      - services
      - endpoints
      - pods
    verbs:
      - get
      - watch
      - list
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: promtail
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: promtail
subjects:
  - kind: ServiceAccount
    name: promtail
    namespace: {{ namespace }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: promtail
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: promtail
    app.kubernetes.io/part-of: observability
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: promtail
  template:
    metadata:
      labels:
        app.kubernetes.io/name: promtail
        app.kubernetes.io/part-of: observability
    spec:
      serviceAccountName: promtail
      containers:
        - name: promtail
          image: {{ promtail.image | default('grafana/promtail:3.1.1') }}
          imagePullPolicy: IfNotPresent
          args:
            - -config.file=/etc/promtail/config.yml
          volumeMounts:
            - name: config
              mountPath: /etc/promtail
              readOnly: true
            - name: run
              mountPath: /run/promtail
            - name: pods
              mountPath: /var/log/pods
              readOnly: true
          resources:
{{ promtail.resources | default({'requests': {'cpu': '25m', 'memory': '64Mi'}, 'limits': {'cpu': '200m', 'memory': '256Mi'}}) | to_nice_yaml(indent=2) | indent(12, true) }}
      volumes:
        - name: config
          configMap:
            name: promtail-config
        - name: run
          emptyDir: {}
        - name: pods
          hostPath:
            path: /var/log/pods
{% endif %}
{% if domain %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: grafana
  namespace: {{ namespace }}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
{% if cert_manager_enabled %}
    cert-manager.io/cluster-issuer: {{ cert_manager_issuer.name | default('letsencrypt-prod') }}
{% else %}
    traefik.ingress.kubernetes.io/router.tls.certresolver: {{ k3s.traefik_acme.resolver_name | default('letsencrypt') }}
{% endif %}
spec:
  ingressClassName: {{ grafana.ingress_class | default('traefik') }}
  tls:
    - hosts:
        - {{ domain }}
{% if cert_manager_enabled %}
      secretName: {{ tls_secret }}
{% endif %}
  rules:
    - host: {{ domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: grafana
                port:
                  name: http
{% if cert_manager_enabled %}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: grafana-tls
  namespace: {{ namespace }}
spec:
  secretName: {{ tls_secret }}
  dnsNames:
    - {{ domain }}
  issuerRef:
    name: {{ cert_manager_issuer.name | default('letsencrypt-prod') }}
    kind: ClusterIssuer
{% endif %}
{% endif %}
