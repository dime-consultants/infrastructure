{% set grafana = k3s_grafana | default({}) %}
{% set namespace = grafana.namespace | default('grafana') %}
{% set domain = grafana.domain %}
{% set tls_secret = grafana.tls_secret | default((domain ~ '-tls') | regex_replace('[^A-Za-z0-9-]', '-') | lower) %}
{% set cert_manager_config = k3s.cert_manager | default({}) %}
{% set cert_manager_issuer = cert_manager_config.cluster_issuer | default({}) %}
{% set cert_manager_enabled = cert_manager_config.enabled | default(false) | bool and cert_manager_issuer.enabled | default(true) | bool %}
apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: {{ namespace }}
type: Opaque
stringData:
  admin-user: {{ grafana_admin_user | to_json }}
  admin-password: {{ grafana_admin_password | to_json }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasources
  namespace: {{ namespace }}
data:
  datasources.yaml: |
    apiVersion: 1
    datasources: []
---
kind: PersistentVolumeClaim
apiVersion: v1
metadata:
  name: grafana
  namespace: {{ namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ grafana.storage_size | default('10Gi') }}
{% if grafana.storage_class is defined %}
  storageClassName: {{ grafana.storage_class }}
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: grafana
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: grafana
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: grafana
  template:
    metadata:
      labels:
        app.kubernetes.io/name: grafana
    spec:
      securityContext:
        fsGroup: 472
      containers:
        - name: grafana
          image: {{ grafana.image | default('grafana/grafana-oss:11.1.4') }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
          env:
            - name: GF_SECURITY_ADMIN_USER
              valueFrom:
                secretKeyRef:
                  name: grafana-admin
                  key: admin-user
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: grafana-admin
                  key: admin-password
            - name: GF_SERVER_DOMAIN
              value: {{ domain | to_json }}
            - name: GF_SERVER_ROOT_URL
              value: {{ ('https://' ~ domain ~ '/') | to_json }}
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 40
            periodSeconds: 20
          volumeMounts:
            - name: data
              mountPath: /var/lib/grafana
            - name: datasources
              mountPath: /etc/grafana/provisioning/datasources
              readOnly: true
          resources:
{{ grafana.resources | default({'requests': {'cpu': '50m', 'memory': '128Mi'}, 'limits': {'cpu': '500m', 'memory': '512Mi'}}) | to_nice_yaml(indent=2) | indent(12, true) }}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: grafana
        - name: datasources
          configMap:
            name: grafana-datasources
---
apiVersion: v1
kind: Service
metadata:
  name: grafana
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: grafana
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: grafana
  ports:
    - name: http
      port: 80
      targetPort: http
      protocol: TCP
{% if domain %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: grafana
  namespace: {{ namespace }}
  annotations:
{% if cert_manager_enabled %}
    cert-manager.io/cluster-issuer: {{ cert_manager_issuer.name | default('letsencrypt-prod') }}
{% else %}
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    traefik.ingress.kubernetes.io/router.tls.certresolver: {{ k3s.traefik_acme.resolver_name | default('letsencrypt') }}
{% endif %}
spec:
  ingressClassName: {{ grafana.ingress_class | default('traefik') }}
  tls:
    - hosts:
        - {{ domain }}
      secretName: {{ tls_secret }}
  rules:
    - host: {{ domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: grafana
                port:
                  name: http
{% if cert_manager_enabled %}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: grafana-tls
  namespace: {{ namespace }}
spec:
  secretName: {{ tls_secret }}
  dnsNames:
    - {{ domain }}
  issuerRef:
    name: {{ cert_manager_issuer.name | default('letsencrypt-prod') }}
    kind: ClusterIssuer
{% endif %}
{% endif %}
