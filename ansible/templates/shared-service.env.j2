COMPOSE_PROJECT_NAME=shared_{{ shared_service_name }}_{{ shared_service_env }}
SHARED_ENV={{ shared_service_env }}
SHARED_NETWORK={{ shared_service_env_config.network }}
SERVICE_HOST={{ shared_service_env_config.service_host }}
SERVICE_VOLUME={{ shared_service_env_config.volume | default('') }}
{% set service_environment = shared_service_subscription.environments[shared_service_env] if shared_service_subscription.environments is mapping else {} %}
{% set service_secrets = (shared_service_secrets | default({})).get(shared_service_name, {}).get(shared_service_env, {}) %}
{% set service_secret_names = service_environment.secret_names | default(shared_service_env_config.secret_names | default({})) %}

{% if shared_service_name == 'postgres' %}
POSTGRES_PORT={{ shared_service_env_config.published_port }}
POSTGRES_DB={{ shared_service_env_config.database | default(service_secrets.get('database', 'postgres')) }}
POSTGRES_USER={{ shared_service_env_config.username | default(service_secrets.get('username', lookup('env', service_secret_names.get('username', '')) | default('app', true))) }}
POSTGRES_PASSWORD={{ shared_service_env_config.password | default(service_secrets.get('password', lookup('env', service_secret_names.get('password', '')) | default('change-me', true))) }}
{% elif shared_service_name == 'rabbitmq' %}
RABBITMQ_AMQP_PORT={{ shared_service_env_config.amqp_port }}
RABBITMQ_MANAGEMENT_PORT={{ shared_service_env_config.management_port }}
RABBITMQ_DEFAULT_USER={{ shared_service_env_config.username | default(service_secrets.get('username', lookup('env', service_secret_names.get('username', '')) | default('app', true))) }}
RABBITMQ_DEFAULT_PASS={{ shared_service_env_config.password | default(service_secrets.get('password', lookup('env', service_secret_names.get('password', '')) | default('change-me', true))) }}
{% elif shared_service_name == 'portainer' %}
PORTAINER_HTTP_PORT={{ shared_service_env_config.http_port }}
PORTAINER_HTTPS_PORT={{ shared_service_env_config.https_port }}
{% elif shared_service_name == 'grafana' %}
GRAFANA_PORT={{ shared_service_env_config.published_port }}
GF_SECURITY_ADMIN_USER={{ shared_service_env_config.username | default(service_secrets.get('username', lookup('env', service_secret_names.get('username', '')) | default('admin', true))) }}
GF_SECURITY_ADMIN_PASSWORD={{ shared_service_env_config.password | default(service_secrets.get('password', lookup('env', service_secret_names.get('password', '')) | default('change-me', true))) }}
LOKI_VOLUME={{ shared_service_env_config.loki_volume | default('shared_loki_' ~ shared_service_env ~ '_data') }}
PROMTAIL_VOLUME={{ shared_service_env_config.promtail_volume | default('shared_promtail_' ~ shared_service_env ~ '_data') }}
{% elif shared_service_name == 'flower' %}
FLOWER_PORT={{ shared_service_env_config.published_port }}
{% set rabbitmq_secrets = (shared_service_secrets | default({})).get('rabbitmq', {}).get(shared_service_env, {}) %}
{% set rabbitmq = namespace(secret_names={}) %}
{% for subscribed_service in shared_services | default([]) %}
{% if subscribed_service.name == 'rabbitmq' and subscribed_service.environments is mapping and shared_service_env in subscribed_service.environments %}
{% set rabbitmq.secret_names = subscribed_service.environments[shared_service_env].secret_names | default(shared_service_catalog.rabbitmq.environments[shared_service_env].secret_names | default({})) %}
{% endif %}
{% endfor %}
{% set rabbitmq_secret_names = rabbitmq.secret_names | default({}) %}
{% set rabbitmq_user = rabbitmq_secrets.get('username', lookup('env', rabbitmq_secret_names.get('username', '')) | default('app', true)) %}
{% set rabbitmq_password = rabbitmq_secrets.get('password', lookup('env', rabbitmq_secret_names.get('password', '')) | default('change-me', true)) %}
CELERY_BROKER_URL={{ shared_service_env_config.broker_url | default('amqp://' ~ rabbitmq_user ~ ':' ~ rabbitmq_password ~ '@rabbitmq:5672//') }}
{% endif %}
